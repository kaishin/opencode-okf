{
  "name": "opencode-okf",
  "version": "0.6.1",
  "description": "OpenCode plugin for creating, maintaining, and validating Open Knowledge Format bundles",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run test && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "okf",
    "open-knowledge-format",
    "knowledge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaishin/opencode-okf.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.11"
}
